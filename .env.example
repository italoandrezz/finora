# Apenas exemplos locais. Copie para .env e substitua a senha antes de iniciar.
POSTGRES_DB=finora
DB_USERNAME=finora_local
DB_PASSWORD=substitua-por-uma-senha-local
DB_URL=jdbc:postgresql://localhost:5432/finora
SPRING_PROFILES_ACTIVE=dev
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
# VITE_* são públicos. O padrão /api usa o proxy do Vite.
VITE_API_BASE_URL=/api
